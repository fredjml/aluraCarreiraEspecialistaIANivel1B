flowchart TD
  I([Início — Pedido enviado]) --> A(Registrar envio no handoff)
  A --> B(Enviar notificação ao pós-vendas)
  B --> C(Confirmar entrega)
  C --> D{Entrega confirmada?}
  D -- Não --> E(Aguardar e verificar novamente)
  E --> C
  D -- Sim --> F(Enviar pesquisa de satisfação)
  F --> G(Classificar feedback)
  G --> H{Cliente insatisfeito?}
  H -- Sim --> J(Notificar equipe e aguardar aprovação humana)
  H -- Não --> K(Enviar agradecimento e aguardar aprovação humana)
  J --> Z([Fim — Ciclo encerrado])
  K --> Z

  classDef auto stroke:#d32f2f,stroke-width:3px,fill:#fff5f5;
  class A,B,C,E,F,G,J,K auto;

%% Critérios de automação:
%% A = repetitividade + regras claras + rastreabilidade
%% B = transferência de informações entre equipes + rastreabilidade
%% C = criticidade + rastreabilidade
%% E = criticidade + rastreabilidade + looping de verificação
%% F = repetitividade + regras claras
%% G = regras claras + rastreabilidade
%% J/K = repetitividade + transferência de informações + aprovação humana
